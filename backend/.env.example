# --- Server ---
PORT=4000
NODE_ENV=development
# Origin của frontend (CORS) — nhiều origin cách nhau bởi dấu phẩy
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — nhớ đổi provider trong prisma/schema.prisma:
# DATABASE_URL="postgresql://ntt:ntt@localhost:5432/ntt?schema=public"

# --- Auth ---
# Chuỗi ngẫu nhiên dài ≥ 32 ký tự: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Tài khoản admin tạo khi seed ---
ADMIN_EMAIL=admin@nttvietnam.vn
ADMIN_PASSWORD=ChangeMe@2026
ADMIN_NAME=Quản trị viên

# --- Email thông báo khi có yêu cầu báo giá / ứng tuyển (để trống = chỉ ghi log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NTT Logistics Website <no-reply@nttvietnam.vn>"
NOTIFY_EMAIL=director2015@nttvietnam.vn

# --- Lưu trữ ảnh & CV ---
# s3    = object storage chuẩn S3: MinIO (dev, docker-compose.dev.yml), Cloudflare R2, AWS S3…
# local = ổ đĩa (backend/storage/objects) — không cần cài gì
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ntt-media
S3_ACCESS_KEY_ID=ntt
S3_SECRET_ACCESS_KEY=ntt-dev-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
# Để trống: ảnh phục vụ qua backend tại /media/... (URL không đổi khi đổi nhà cung cấp).
# Hoặc đặt domain CDN công khai của bucket, VD https://media.nttvietnam.vn
STORAGE_PUBLIC_URL=
