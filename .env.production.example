# ===== Cấu hình website NTT Logistics (production) =====
# Sao chép thành .env rồi điền. Tạo chuỗi ngẫu nhiên bằng lệnh:  openssl rand -hex 24

# Tên miền. Có tên miền → HTTPS tự động. Chưa có tên miền → dùng ":80" và truy cập bằng http://IP-MÁY-CHỦ
SITE_DOMAIN=nttvietnam.vn, www.nttvietnam.vn
# Địa chỉ đầy đủ của website (dùng cho SEO, sitemap). Khi chạy bằng IP: http://IP-MÁY-CHỦ
SITE_URL=https://nttvietnam.vn
# Chạy bằng http://IP (chưa có HTTPS) thì đặt false, nếu không sẽ không đăng nhập được trang quản trị
COOKIE_SECURE=true

# Mật khẩu (bắt buộc — mỗi cái một chuỗi ngẫu nhiên khác nhau)
DB_PASSWORD=
MINIO_PASSWORD=
# Tối thiểu 32 ký tự:  openssl rand -hex 32
JWT_SECRET=

# Tài khoản quản trị tạo lần đầu (đổi mật khẩu trong trang Tài khoản sau khi đăng nhập)
ADMIN_EMAIL=admin@nttvietnam.vn
ADMIN_PASSWORD=

# Email thông báo khi có yêu cầu báo giá / ứng tuyển (tùy chọn — để trống thì bỏ qua)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = "Mật khẩu ứng dụng" của Google
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=director2015@nttvietnam.vn
